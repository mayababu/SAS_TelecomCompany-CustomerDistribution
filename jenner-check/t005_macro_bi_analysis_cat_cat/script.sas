*METHOD USING MACRO;

%MACRO BI_ANALYSIS_CAT_CAT (DSN = ,VAR1= , VAR2= );
PROC FREQ DATA =&DSN;
TITLE " RELATION BETWEEN &VAR1. AND &VAR2.";
TABLE &VAR1.*&VAR2/chisq;
PROC SGPLOT DATA = &DSN;
 VBAR &VAR1/GROUP = &VAR2 GROUPDISPLAY = CLUSTER;
 RUN;
%MEND BI_ANALYSIS_CAT_CAT;

data work.segments;
infile datalines dlm='|' dsd;
length age_group $25 sales_group $25 province $2;
input acctno age_group sales_group province;
datalines;
10001|20 OR LESS|$100 & BELOW|ON
10002|BETWEEN 21 & 40|$100 - $500|BC
10003|BETWEEN 21 & 40|$500 - $800|QC
10004|BETWEEN 41 - 60|800 & ABOVE|AB
10005|20 OR LESS|$100 & BELOW|NS
10006|BETWEEN 41 - 60|$500 - $800|ON
10007|60 & MORE|800 & ABOVE|BC
10008|BETWEEN 21 & 40|$100 - $500|QC
10009|60 & MORE|800 & ABOVE|AB
10010|BETWEEN 21 & 40|$100 & BELOW|NS
10011|BETWEEN 21 & 40|$500 - $800|ON
10012|60 & MORE|$100 & BELOW|BC
10013|BETWEEN 41 - 60|$100 - $500|QC
10014|BETWEEN 21 & 40|800 & ABOVE|AB
10015|BETWEEN 41 - 60|$100 & BELOW|NS
;
run;

%BI_ANALYSIS_CAT_CAT(DSN = work.segments, VAR1 = AGE_GROUP, VAR2 = SALES_GROUP);
%BI_ANALYSIS_CAT_CAT(DSN = work.segments, VAR1 = SALES_GROUP, VAR2 = PROVINCE);
title;
